diff --git a/src/lib/notifications.ts b/src/lib/notifications.ts
index ae6c21b..b744e7e 100644
--- a/src/lib/notifications.ts
+++ b/src/lib/notifications.ts
@@ -22,3 +22,28 @@ export async function createCustomerNotification(db: DbClient, data: {
   }
   return db.notification.create({ data: { ...data, userId: data.userId } });
 }
+
+export async function createAdminNotifications(db: DbClient, data: {
+  type: NotificationType;
+  title: string;
+  message: string;
+  href: string;
+  eventKey: string;
+}) {
+  const admins = await db.user.findMany({
+    where: { role: { in: ["ADMIN", "MANAGER"] }, blockedAt: null },
+    select: { id: true }
+  });
+  if (!admins.length) return { count: 0 };
+  return db.notification.createMany({
+    data: admins.map((admin) => ({
+      userId: admin.id,
+      type: data.type,
+      title: data.title,
+      message: data.message,
+      href: data.href,
+      eventKey: `${data.eventKey}-${admin.id}`
+    })),
+    skipDuplicates: true
+  });
+}
