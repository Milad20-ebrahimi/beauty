generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
}

enum SkinType {
  OILY
  DRY
  COMBINATION
  NORMAL
  SENSITIVE
  UNKNOWN
}

enum HairType {
  STRAIGHT
  WAVY
  CURLY
  COILY
  UNKNOWN
}

enum BudgetTier {
  ECONOMY
  BALANCED
  PREMIUM
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductRole {
  CLEANSER
  MOISTURIZER
  SUNSCREEN
  SERUM
  TONER
  MAKEUP
  HAIRCARE
  BODYCARE
  FRAGRANCE
  OTHER
}

enum RoutinePeriod {
  MORNING
  NIGHT
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ReviewSource {
  VERIFIED_PURCHASE
  CUSTOMER
  IMPORTED
}

enum PaymentReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryMovementType {
  ADJUSTMENT
  RESERVATION
  RELEASE
  SALE
  RETURN
}

model User {
  id             String          @id @default(cuid())
  phone          String?         @unique
  email          String?         @unique
  displayName    String?
  role           UserRole        @default(CUSTOMER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  beautyProfiles BeautyProfile[]
  reviews        Review[]
  carts          Cart[]
  orders         Order[]
  analytics      AnalyticsEvent[]
}

model BeautyProfile {
  id                  String       @id @default(cuid())
  userId              String
  label               String       @default("پروفایل اصلی")
  skinType            SkinType     @default(UNKNOWN)
  hairType            HairType     @default(UNKNOWN)
  budgetTier          BudgetTier   @default(BALANCED)
  sensitivityLevel    Int          @default(0)
  makeupStyle         String?
  approximateTone     String?
  fragranceFree       Boolean      @default(false)
  alcoholFree         Boolean      @default(false)
  premiumPreference   Boolean      @default(false)
  medicalDisclaimerAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  concerns            ProfileConcern[]
  favoriteBrands      ProfileFavoriteBrand[]
  matchScores         MatchScoreSnapshot[]
  routines            Routine[]

  @@index([userId])
}

model Concern {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String?
  profiles    ProfileConcern[]
  products    ProductConcern[]
}

model ProfileConcern {
  profileId String
  concernId String
  weight    Int      @default(1)
  profile   BeautyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  concern   Concern       @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([profileId, concernId])
}

model Brand {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  country     String?
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  products    Product[]
  fans        ProfileFavoriteBrand[]
}

model ProfileFavoriteBrand {
  profileId String
  brandId   String
  profile   BeautyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  brand     Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([profileId, brandId])
}

model Category {
  id        String     @id @default(cuid())
  parentId  String?
  slug      String     @unique
  title     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
}

model Product {
  id                  String          @id @default(cuid())
  brandId             String
  categoryId          String
  slug                String          @unique
  title               String
  subtitle            String?
  description         String?
  status              ProductStatus   @default(DRAFT)
  role                ProductRole     @default(OTHER)
  price               Int
  compareAtPrice      Int?
  budgetTier          BudgetTier      @default(BALANCED)
  stock               Int             @default(0)
  reservedStock       Int             @default(0)
  fragranceFree       Boolean?
  alcoholFree         Boolean?
  suitableForSensitive Boolean?
  sponsored           Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  brand               Brand           @relation(fields: [brandId], references: [id])
  category            Category        @relation(fields: [categoryId], references: [id])
  media               ProductMedia[]
  ingredients         ProductIngredient[]
  concerns            ProductConcern[]
  skinSuitability     ProductSkinSuitability[]
  reviews             Review[]
  routineItems        RoutineItem[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  matchScores         MatchScoreSnapshot[]
  inventoryMovements  InventoryMovement[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status, role])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Ingredient {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  description String?
  products    ProductIngredient[]
}

model ProductIngredient {
  productId    String
  ingredientId String
  position     Int?
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
}

model ProductConcern {
  productId String
  concernId String
  strength  Int      @default(1)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  concern   Concern  @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([productId, concernId])
}

model ProductSkinSuitability {
  productId String
  skinType  SkinType
  score     Int      @default(0)
  note      String?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, skinType])
}

model Review {
  id               String        @id @default(cuid())
  productId        String
  userId           String?
  source           ReviewSource  @default(CUSTOMER)
  rating           Int
  title            String?
  body             String?
  skinTypeAtReview SkinType      @default(UNKNOWN)
  budgetTierAtReview BudgetTier?
  wouldRepurchase  Boolean?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  outcome          ReviewOutcome?

  @@index([productId, skinTypeAtReview])
  @@index([source])
}

model ReviewOutcome {
  id              String   @id @default(cuid())
  reviewId        String   @unique
  satisfaction    Int
  irritation      Boolean?
  helpedConcern   Boolean?
  daysUsed        Int?
  outcomeSummary  String?
  createdAt       DateTime @default(now())
  review          Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Routine {
  id          String        @id @default(cuid())
  profileId   String?
  title       String
  concernId   String?
  budgetTier  BudgetTier    @default(BALANCED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  profile     BeautyProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  items       RoutineItem[]

  @@index([profileId])
}

model RoutineItem {
  id          String        @id @default(cuid())
  routineId   String
  productId   String
  period      RoutinePeriod
  stepOrder   Int
  note        String?
  routine     Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])

  @@index([routineId, period])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String?
  status      OrderStatus @default(DRAFT)
  subtotal    Int
  discount    Int         @default(0)
  shippingFee Int         @default(0)
  total       Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  expiresAt   DateTime?
  inventoryFinalizedAt DateTime?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  address     OrderAddress?
  paymentReceipt PaymentReceipt?
  inventoryMovements InventoryMovement[]

  @@index([userId])
  @@index([status])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  orderId       String?
  type          InventoryMovementType
  stockDelta    Int                   @default(0)
  reservedDelta Int                   @default(0)
  note          String?
  createdAt     DateTime              @default(now())
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  order         Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
}

model PaymentReceipt {
  id          String               @id @default(cuid())
  orderId     String               @unique
  imageUrl    String
  status      PaymentReceiptStatus @default(PENDING)
  customerNote String?
  adminNote   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  reviewedAt  DateTime?
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model ManualPaymentSettings {
  id           String   @id @default("default")
  cardNumber   String
  iban         String?
  holderName   String
  bankName     String?
  instructions String?
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model OrderAddress {
  id            String   @id @default(cuid())
  orderId       String   @unique
  recipientName String
  phone         String
  province      String
  city          String
  addressLine   String
  postalCode    String?
  deliveryNote  String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model MatchScoreSnapshot {
  id             String        @id @default(cuid())
  profileId      String
  productId      String
  score          Int
  positiveReasons Json
  warnings       Json
  missingData    Json
  ruleVersion    String
  createdAt      DateTime      @default(now())
  profile        BeautyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([profileId, productId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  name      String
  payload   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId])
}
