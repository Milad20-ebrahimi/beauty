DATABASE_URL="postgresql://postgres:postgres@localhost:5433/beauty_os?schema=public"
NEXT_PUBLIC_APP_NAME="BeautyOS"

# Generate a long random value for production (at least 32 characters).
AUTH_SECRET="replace-with-a-long-random-secret"

# Local owner login. Never commit real values to Git.
ADMIN_PHONE="09120000000"
ADMIN_ACCESS_CODE="change-this-code"

# Shows the OTP on the login page for local development. Set false in production.
CUSTOMER_OTP_DEV_MODE="true"
